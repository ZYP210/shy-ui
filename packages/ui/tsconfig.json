{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": false,
    "declaration": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "./",
    "types": ["vue-types", "vue"],
    "typeRoots": ["./node_modules/@types/", "./types"],
    "paths": {
      "/@/*": ["src/*"],
      "csstype": [
        "/Users/yu/Work/shy-ui/node_modules/.pnpm/csstype@3.1.2/node_modules/csstype/index"
      ]
    }
  },

  "include": [
    "types/**/*.ts",
    "./**/*.ts",
    "./**/*.d.ts",
    "./**/*.tsx",
    "./**/*.vue",
    "*.d.ts"
  ],
  "exclude": ["dist", "**/*.js"]
}
